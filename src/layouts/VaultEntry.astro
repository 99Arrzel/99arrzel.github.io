---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { VAULT_TOPICS } from '../vault';

type Props = CollectionEntry<'vault'>['data'];

const { title, description, pubDate, updatedDate, topic, heroImage } = Astro.props;
const topicMeta = VAULT_TOPICS[topic];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | The Vault`} description={description ?? SITE_TITLE} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article class="entry">
				<div class="entry-top">
					<a class="back" href="/vault">&larr; The Vault</a>
					<a class="topic-badge" href={`/vault#${topic}`}>
						<span aria-hidden="true">{topicMeta.icon}</span> {topicMeta.name}
					</a>
				</div>
				<h1>{title}</h1>
				<p class="meta">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated"> &middot; updated <FormattedDate date={updatedDate} /></span>
						)
					}
				</p>
				{heroImage && (
					<div class="hero">
						<Image src={heroImage} alt="" width={1020} height={510} />
					</div>
				)}
				<hr />
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.entry-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 1.5em;
	}
	.back {
		color: var(--text-light);
		text-decoration: none;
		font-size: 0.9em;
	}
	.back:hover {
		color: var(--accent);
	}
	.topic-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.25em 0.7em;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--accent);
		text-decoration: none;
		font-size: 0.8em;
		white-space: nowrap;
	}
	.topic-badge:hover {
		border-color: var(--accent);
	}
	h1 {
		margin: 0 0 0.25em 0;
	}
	.meta {
		margin: 0 0 1.25em 0;
		color: var(--text-light);
		font-size: 0.9em;
	}
	.hero {
		margin: 0 0 1.5em 0;
	}
	.hero :global(img) {
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	hr {
		margin: 0 0 2em 0;
	}
	/* The rendered markdown. Global rules in global.css already style headings,
	   paragraphs, code, blockquotes and (responsively) images inside here. */
	.prose :global(h2) {
		margin-top: 1.5em;
	}
	.prose :global(h3) {
		margin-top: 1.25em;
	}
</style>
