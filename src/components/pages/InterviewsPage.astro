---
import { Code } from 'astro:components';
import BaseHead from '../BaseHead.astro';
import Docs from '../Docs.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import Pager from '../Pager.astro';
import { SITE_TITLE } from '../../consts';
import { interviews as copy } from '../../i18n/interviews';
import type { Lang } from '../../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];

const subFor = (n: number) =>
	(n === 1 ? c.oneInterview.one : c.oneInterview.many).replace('{n}', String(n));

// The menu groups the questions by interview; the "previous / next" links at
// the foot of each one walk them in the same order, across interviews.
const all = c.interviews.flatMap((iv) => iv.questions.map((q) => ({ iv, q })));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${c.metaTitle} | ${SITE_TITLE}`} description={c.metaDescription} />
	</head>
	<body>
		<Header />
		<main class="docs-page">
			<header class="docs-head">
				<h1>{c.title}</h1>
				<p>
					{c.intro}<em>{c.introEmphasis}</em>{c.introTail}
				</p>
			</header>

			<Docs label={c.menuLabel} mode="panels">
				<Fragment slot="menu">
					{
						c.interviews.map((iv) => (
							<>
								<p class="docs-group">
									{iv.company} <span aria-hidden="true">&middot;</span> {iv.date}
								</p>
								<ul>
									{/* The topic rides along on the right, so the menu doubles
									     as the index by subject. */}
									{iv.questions.map((q) => (
										<li>
											<a href={`#${q.id}`}>
												<span class="t">{q.title}</span>
												<span class="note">{q.topic}</span>
											</a>
										</li>
									))}
								</ul>
							</>
						))
					}
				</Fragment>

				{
					all.map(({ iv, q }, i) => {
						const prev = all[i - 1]?.q;
						const next = all[i + 1]?.q;
						return (
							<section class="doc-panel" id={q.id} tabindex="-1" aria-labelledby={`${q.id}-title`}>
								<p class="doc-eyebrow">
									{iv.company} <span aria-hidden="true">&middot;</span> {iv.role}{' '}
									<span aria-hidden="true">&middot;</span> {iv.date}
								</p>
								<h2 class="doc-title" id={`${q.id}-title`}>
									{q.prompt}
								</h2>
								<p class="sub">{iv.sub ? iv.sub : subFor(iv.questions.length)}</p>

								{q.slip && (
									<p class="slip">
										<strong>{c.slipLabel}</strong> {q.slip}
									</p>
								)}
								{q.heard && (
									<p class="slip">
										<strong>{c.heardLabel}</strong> {q.heard}
									</p>
								)}

								<div class="answer">
									<p class="answer-label">{q.heard ? c.heardAnswerLabel : c.answerLabel}</p>
									<p>{q.answer}</p>
									{q.snippet && <Code code={q.snippet} lang={q.snippetLang ?? 'js'} theme="github-dark" />}
								</div>

								<ul class="tag-row">
									{q.tags.map((t) => (
										<li>{t}</li>
									))}
								</ul>

								<Pager prev={prev} next={next} />
							</section>
						);
					})
				}
			</Docs>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* A question is a sentence, not a name: smaller than the other pages'
	   panel titles so a long one doesn't run to five lines. */
	.doc-title {
		font-size: 1.7em;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}
	/* Which interview this was, or what kind. */
	.sub {
		margin: 0.75em 0 1.75em;
		font-size: 0.85em;
		color: var(--text-light);
	}
	.slip {
		margin: 0 0 1.5em;
		padding-left: 1em;
		border-left: 2px solid var(--border);
		color: var(--text-light);
		font-size: 0.93em;
		line-height: 1.6;
	}
	.slip strong {
		color: var(--text);
	}
	.answer {
		margin-bottom: 1.25em;
		padding: 1.25em 1.4em;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: var(--radius);
		background: var(--bg-secondary);
	}
	.answer-label {
		margin: 0 0 0.8em;
		font-family: var(--mono);
		font-size: 0.66em;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--accent);
	}
	.answer p:not(.answer-label) {
		margin: 0;
		font-size: 0.95em;
		line-height: 1.65;
	}
	/* Shiki-highlighted block from the <Code> component. The global `pre` rule
	   forces its own background with !important, so override it here to let the
	   github-dark theme background through and keep the block on-brand. */
	.answer :global(pre.astro-code) {
		margin: 1.1em 0 0;
		padding: 1em 1.25em;
		border: 1px solid var(--border);
		border-radius: 8px;
		font-size: 0.8em;
		line-height: 1.55;
		overflow-x: auto;
		background-color: #0d1117 !important;
	}
	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Neutral on purpose. Blue is for things you can click. */
	.tag-row li {
		padding: 0.15em 0.6em;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.04);
		font-family: var(--mono);
		font-size: 0.68em;
		color: var(--text);
	}
</style>
