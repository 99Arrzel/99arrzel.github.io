---
import { Image } from 'astro:assets';
import BaseHead from '../BaseHead.astro';
import Docs from '../Docs.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import Pager from '../Pager.astro';
import { SITE_TITLE } from '../../consts';
import { projects as copy } from '../../i18n/projects';
import { localizePath, type Lang } from '../../i18n';
import cvPress from '../../assets/projects/cv-press.png';
import dijkstra from '../../assets/projects/dijkstra.png';
import pmsacRecords from '../../assets/projects/pmsac-records.png';
import pmsacScan from '../../assets/projects/pmsac-scan.png';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const cvHref = localizePath('/cv', lang);

// Screenshots, by the `key` a project's `shots` entry names in the copy. To
// give a project a picture: drop the file in src/assets/projects/, import it
// above, add it here, and name it in both locales of src/i18n/projects.ts.
const shots: Record<string, ImageMetadata> = {
	'cv-press': cvPress,
	dijkstra,
	'pmsac-records': pmsacRecords,
	'pmsac-scan': pmsacScan,
};

// The menu is grouped; the "previous / next" links at the foot of each panel
// walk the same projects in the same order, ignoring the groups.
const all = c.groups.flatMap((g) => g.projects);
const DECEMBER = Array.from({ length: 25 }, (_, i) => i + 1);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${c.metaTitle} | ${SITE_TITLE}`} description={c.metaDescription} />
	</head>
	<body>
		<Header />
		<main class="docs-page">
			<header class="docs-head">
				<h1>{c.title}</h1>
				<p set:html={c.introHtml} />
			</header>

			<Docs label={c.menuLabel} mode="panels">
				<Fragment slot="menu">
					{
						c.groups.map((group) => (
							<>
								<p class="docs-group">{group.label}</p>
								<ul>
									{group.projects.map((p) => (
										<li>
											<a href={`#${p.slug}`}>
												<span class="t">{p.name}</span>
												<span class="note">{p.year}</span>
											</a>
										</li>
									))}
								</ul>
							</>
						))
					}
				</Fragment>

				{
					all.map((p, i) => {
						const prev = all[i - 1];
						const next = all[i + 1];
						// CV Press is the one project that lives on this site rather
						// than in a repo, so it gets a live marker and a way in.
						const here = !p.url;
						return (
							<section class="doc-panel" id={p.slug} tabindex="-1" aria-labelledby={`${p.slug}-title`}>
								<p class="doc-eyebrow">
									{here && <span class="live-dot" aria-hidden="true" />}
									{p.kind} <span aria-hidden="true">&middot;</span> {p.year}
								</p>
								<h2 class="doc-title" id={`${p.slug}-title`}>
									{p.name}
								</h2>
								<p class="doc-lede">{p.tagline}</p>

								{p.shots?.map((shot) => (
									<figure class="shot">
										<Image
											src={shots[shot.key]}
											alt={shot.alt}
											widths={[480, 800, 1200, shots[shot.key].width]}
											sizes="(max-width: 900px) 100vw, 790px"
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									</figure>
								))}

								{p.body.map((html) => (
									<p set:html={html} />
								))}

								{p.steps && (
									<>
										<h3 class="sub">{c.howTitle}</h3>
										<ol class="flow">
											{p.steps.map((step) => (
												<li>
													<strong>{step.title}</strong>
													<span>{step.note}</span>
												</li>
											))}
										</ol>
									</>
								)}

								{p.days && (
									<figure class="days">
										<ol aria-hidden="true">
											{DECEMBER.map((day) => (
												<li class:list={{ done: p.days!.includes(day) }}>{day}</li>
											))}
										</ol>
										<figcaption>{c.daysCaption}</figcaption>
									</figure>
								)}

								<h3 class="sub">{c.stackTitle}</h3>
								<ul class="tech-tags">
									{p.tech.map((t) => (
										<li>{t}</li>
									))}
								</ul>

								<p class="actions">
									{here && (
										<a class="btn primary" href={cvHref}>
											{c.toolCta} <span aria-hidden="true">&rarr;</span>
										</a>
									)}
									{p.demo && (
										<a class="btn primary" href={p.demo} target="_blank" rel="noopener">
											{c.demoLabel} <span aria-hidden="true">&nearr;</span>
										</a>
									)}
									{p.url && (
										<a class="btn" href={p.url} target="_blank" rel="noopener">
											{c.repoLabel} <span aria-hidden="true">&nearr;</span>
										</a>
									)}
									{p.extra && (
										<a class="btn" href={p.extra.url} target="_blank" rel="noopener">
											{p.extra.label} <span aria-hidden="true">&nearr;</span>
										</a>
									)}
								</p>

								<Pager
									prev={prev && { id: prev.slug, title: prev.name }}
									next={next && { id: next.slug, title: next.name }}
								/>
							</section>
						);
					})
				}
			</Docs>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* The intro carries a link, and the brief paragraphs are set:html, so both
	   are out of reach of scoped selectors without :global. */
	.doc-panel > p:not([class]) {
		margin: 0 0 1.1em;
	}
	.doc-panel :global(code) {
		font-size: 0.85em;
	}

	/* Green means "running right now", and only CV Press is. */
	.live-dot {
		display: inline-block;
		width: 0.6em;
		height: 0.6em;
		margin-right: 0.5em;
		border-radius: 50%;
		background: #3fb98a;
		animation: live-pulse 2.4s ease-out infinite;
	}
	@keyframes live-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(63, 185, 138, 0.55);
		}
		70% {
			box-shadow: 0 0 0 7px rgba(63, 185, 138, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(63, 185, 138, 0);
		}
	}

	/* A screenshot, framed as the window it was taken of. */
	.shot {
		margin: 0 0 1.75em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-secondary);
		overflow: hidden;
	}
	.shot::before {
		content: '';
		display: block;
		height: 1.5em;
		border-bottom: 1px solid var(--border);
		/* Three window buttons, drawn rather than marked up. */
		background:
			radial-gradient(circle at 1em 50%, #4a5361 0.22em, transparent 0.25em),
			radial-gradient(circle at 1.8em 50%, #4a5361 0.22em, transparent 0.25em),
			radial-gradient(circle at 2.6em 50%, #4a5361 0.22em, transparent 0.25em);
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	.sub {
		margin: 2.2em 0 0.9em;
		font-family: var(--mono);
		font-size: 0.68em;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-light);
	}

	/* How it works: the project as a row of numbered steps, each handing over
	   to the next. For most of these it is the closest thing to a picture
	   there is, since what they do happens in a terminal or on a bench. */
	.flow {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: 1.5em;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	.flow li {
		position: relative;
		padding: 0.9em 0.9em 1em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-secondary);
		font-size: 0.72em;
		line-height: 1.45;
		counter-increment: step;
	}
	.flow li::before {
		content: counter(step, decimal-leading-zero);
		display: block;
		margin-bottom: 0.6em;
		font-family: var(--mono);
		font-size: 0.9em;
		color: var(--accent);
	}
	/* The arrow sits in the gap before every step but the first. */
	.flow li + li::after {
		content: '\2192';
		position: absolute;
		top: 50%;
		left: -1.55em;
		transform: translateY(-50%);
		color: var(--text-light);
	}
	.flow strong {
		display: block;
		margin-bottom: 0.3em;
		color: var(--text-heading);
	}
	.flow span {
		color: var(--text-light);
	}

	/* Advent of Code: the 25 days of the calendar, the solved ones lit. */
	.days {
		margin: 1.75em 0 0;
	}
	.days ol {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.4em;
		max-width: 15em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.days li {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border: 1px solid var(--border);
		border-radius: 8px;
		font-family: var(--mono);
		font-size: 0.7em;
		color: var(--text-light);
		opacity: 0.6;
	}
	.days li.done {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--text-heading);
		opacity: 1;
	}
	.days figcaption {
		margin-top: 0.8em;
		font-size: 0.75em;
		color: var(--text-light);
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Neutral on purpose. Blue is for things you can click. */
	.tech-tags li {
		padding: 0.15em 0.6em;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.04);
		font-family: var(--mono);
		font-size: 0.68em;
		color: var(--text);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
		margin: 2.2em 0 0;
	}

	@media (max-width: 900px) {
		/* No room for a row: the steps stack and the arrows point down. */
		.flow {
			grid-auto-flow: row;
			gap: 1.6em;
		}
		.flow li {
			font-size: 0.8em;
		}
		.flow li + li::after {
			content: '\2193';
			top: -1.6em;
			left: 1.2em;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.live-dot {
			animation: none;
		}
	}
</style>
