---
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import { SITE_TITLE } from '../../consts';
import { projects as copy } from '../../i18n/projects';
import { localizePath, type Lang } from '../../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const cvHref = localizePath('/cv', lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${c.metaTitle} | ${SITE_TITLE}`} description={c.metaDescription} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{c.title}</h1>
			<p set:html={c.introHtml} />

			<!-- The one thing on this page you can actually use without leaving the
			     site, so it's styled to look operable rather than archival: the
			     whole card is the link, it carries a live indicator, and it shows a
			     miniature of what it produces. -->
			<a class="tool-card" href={cvHref}>
				<div class="tool-copy">
					<span class="tool-eyebrow">
						<span class="tool-dot" aria-hidden="true"></span>
						{c.tool.eyebrow}
					</span>
					<h3>{c.tool.title}</h3>
					<p>{c.tool.body}</p>
					<div class="tech-tags">
						{c.tool.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
					</div>
					<span class="tool-cta">{c.tool.cta} <span aria-hidden="true">&rarr;</span></span>
				</div>
				<div class="tool-mock" aria-hidden="true">
					<div class="mock-sheet">
						<span class="mock-name"></span>
						<span class="mock-sub"></span>
						<span class="mock-rule"></span>
						<span class="mock-line"></span>
						<span class="mock-line short"></span>
						<span class="mock-rule"></span>
						<span class="mock-line"></span>
						<span class="mock-line"></span>
						<span class="mock-line short"></span>
					</div>
				</div>
			</a>

			<div class="projects-grid">
				{
					c.projects.map((project) => (
						<div class="project-card">
							<h3>
								<a href={project.url} target="_blank">
									{project.name}
								</a>
							</h3>
							<p>{project.description}</p>
							<div class="tech-tags">
								{project.tech.map((t) => (
									<span class="tech-tag">{t}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-grid {
		display: grid;
		gap: 1.5em;
	}
	.project-card {
		padding: 1.5em;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 8px;
		transition: border-color 0.2s ease;
	}
	.project-card:hover {
		border-color: var(--accent);
	}
	.project-card h3 {
		margin: 0 0 0.5em 0;
		font-size: 1.2em;
	}
	.project-card h3 a {
		text-decoration: none;
		color: var(--text-heading);
	}
	.project-card h3 a:hover {
		color: var(--accent);
	}
	.project-card p {
		margin: 0 0 0.75em 0;
		color: var(--text-light);
		font-size: 0.9em;
		line-height: 1.5;
	}
	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tech-tag {
		padding: 0.2em 0.6em;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 4px;
		font-size: 0.75em;
		color: var(--accent);
	}

	/* ── Featured live tool ─────────────────────────────────────────
	   Deliberately unlike the cards below it: accent-lit, wider gutters,
	   a working-document miniature, and a button-shaped call to action,
	   so it reads as something to operate rather than a repo to browse. */
	.tool-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.75em;
		align-items: center;
		margin-bottom: 1.5em;
		padding: 1.6em;
		border-radius: 12px;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--accent);
		background:
			radial-gradient(120% 140% at 100% 0%, rgba(109, 159, 255, 0.16), transparent 58%),
			var(--bg-secondary);
		box-shadow: 0 0 0 4px rgba(109, 159, 255, 0.07);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.tool-card:hover,
	.tool-card:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 0 0 4px rgba(109, 159, 255, 0.14);
	}
	.tool-copy {
		min-width: 0;
	}
	.tool-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.7em;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.tool-dot {
		width: 7px;
		height: 7px;
		flex: none;
		/* Sit on the first line: the label wraps to two lines on a phone,
		   and a vertically-centred dot then floats between them. */
		align-self: flex-start;
		margin-top: 0.35em;
		border-radius: 50%;
		background: #3fb98a;
		box-shadow: 0 0 0 0 rgba(63, 185, 138, 0.6);
		animation: tool-pulse 2.4s ease-out infinite;
	}
	@keyframes tool-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(63, 185, 138, 0.55);
		}
		70% {
			box-shadow: 0 0 0 7px rgba(63, 185, 138, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(63, 185, 138, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tool-dot {
			animation: none;
		}
		.tool-card {
			transition: none;
		}
	}
	.tool-card h3 {
		margin: 0.35em 0 0.4em;
		font-size: 1.6em;
		color: var(--text-heading);
	}
	.tool-card:hover h3 {
		color: var(--accent);
	}
	.tool-card p {
		margin: 0 0 1em 0;
		color: var(--text-light);
		font-size: 0.9em;
		line-height: 1.55;
	}
	.tool-cta {
		display: inline-block;
		margin-top: 1.1em;
		padding: 0.5em 1.1em;
		border-radius: 999px;
		background: var(--accent);
		color: #0d1117;
		font-size: 0.82em;
		font-weight: 700;
	}
	.tool-card:hover .tool-cta {
		background: var(--accent-dark);
	}

	/* Miniature of the thing the tool makes. */
	.tool-mock {
		flex: none;
	}
	.mock-sheet {
		width: 118px;
		height: 152px;
		padding: 12px 11px;
		border-radius: 3px;
		background: #fff;
		display: flex;
		flex-direction: column;
		gap: 5px;
		box-shadow:
			0 2px 6px rgba(0, 0, 0, 0.45),
			0 10px 26px rgba(0, 0, 0, 0.35);
		transform: rotate(-2.5deg);
		transition: transform 0.25s ease;
	}
	.tool-card:hover .mock-sheet {
		transform: rotate(0deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.mock-sheet,
		.tool-card:hover .mock-sheet {
			transition: none;
			transform: rotate(-2.5deg);
		}
	}
	.mock-name {
		height: 8px;
		width: 74%;
		border-radius: 2px;
		background: var(--accent);
	}
	.mock-sub {
		height: 4px;
		width: 52%;
		border-radius: 2px;
		background: #9aa4b2;
	}
	.mock-rule {
		height: 2px;
		width: 100%;
		background: #2c3340;
		margin-top: 3px;
	}
	.mock-line {
		height: 3px;
		width: 100%;
		border-radius: 2px;
		background: #ccd2db;
	}
	.mock-line.short {
		width: 62%;
	}

	@media (max-width: 640px) {
		.tool-card {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25em;
			padding: 1.25em;
		}
		.mock-sheet {
			transform: rotate(0deg);
		}
	}
</style>
