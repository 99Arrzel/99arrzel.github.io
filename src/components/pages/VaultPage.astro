---
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Docs from '../Docs.astro';
import Footer from '../Footer.astro';
import FormattedDate from '../FormattedDate.astro';
import Header from '../Header.astro';
import VaultMenu from '../VaultMenu.astro';
import { SITE_TITLE } from '../../consts';
import { VAULT_TOPICS } from '../../vault';
import { vault, topicOrder } from '../../i18n/vault';
import type { Lang } from '../../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = vault[lang];

const entries = (await getCollection('vault', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group entries by topic, keeping only topics that actually have something.
// Entry links stay on the unprefixed /vault/ paths in both locales: the posts
// themselves are only written once.
const topics = topicOrder
	.map((id) => ({
		id,
		icon: VAULT_TOPICS[id].icon,
		name: c.topics[id].name,
		blurb: c.topics[id].blurb,
		entries: entries.filter((e) => e.data.topic === id),
	}))
	.filter((t) => t.entries.length > 0);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${c.metaTitle} | ${SITE_TITLE}`} description={c.metaDescription} />
	</head>
	<body>
		<Header />
		<main class="docs-page">
			<header class="docs-head">
				<h1>{c.title}</h1>
				<p>{c.intro}</p>
				{c.languageNote && entries.length > 0 && <p class="lang-note">{c.languageNote}</p>}
			</header>

			{entries.length === 0 ? (
				<p class="empty">{c.empty}</p>
			) : (
				<Docs label={c.title} mode="pages" current={c.allEntries}>
					<VaultMenu slot="menu" lang={lang} />
					{topics.map((t) => (
						<section class="topic" id={t.id}>
							<header class="topic-head">
								<h2><span aria-hidden="true">{t.icon}</span> {t.name}</h2>
								<p>{t.blurb}</p>
							</header>
							<ul class="entry-list">
								{t.entries.map((e) => (
									<li>
										<a href={`/vault/${e.id}/`}>
											<h3 class="entry-title">{e.data.title}</h3>
											<p class="entry-date"><FormattedDate date={e.data.pubDate} /></p>
											{e.data.description && <p class="entry-desc">{e.data.description}</p>}
										</a>
									</li>
								))}
							</ul>
						</section>
					))}
				</Docs>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.docs-head .lang-note {
		margin-top: 0.75em;
		font-size: 0.85em;
		font-style: italic;
	}
	.empty {
		color: var(--text-light);
	}
	.topic {
		margin-bottom: 3.5em;
	}
	.topic:last-child {
		margin-bottom: 0;
	}
	.topic-head {
		margin-bottom: 1em;
		padding-bottom: 0.5em;
		border-bottom: 1px solid var(--border);
	}
	.topic-head h2 {
		margin: 0;
		font-size: 1.4em;
	}
	.topic-head p {
		margin: 0.35em 0 0 0;
		color: var(--text-light);
		font-size: 0.92em;
	}
	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.entry-list a {
		display: flex;
		flex-direction: column;
		padding: 1.2em 1.4em;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.entry-list a:hover,
	.entry-list a:focus-visible {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.entry-list a {
			transition: none;
		}
	}
	.entry-title {
		margin: 0;
		color: var(--text-heading);
		font-size: 1.2em;
	}
	/* Shown above the title, as the small label of the card; it stays after
	   the heading in the markup so the title is still what a screen reader
	   meets first. */
	.entry-date {
		order: -1;
		margin: 0 0 0.6em;
		font-family: var(--mono);
		font-size: 0.66em;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-light);
	}
	.entry-desc {
		margin: 0.5em 0 0 0;
		color: var(--text-light);
		font-size: 0.92em;
		line-height: 1.6;
	}
</style>
