---
import type { HTMLAttributes } from 'astro/types';
import { stripLang } from '../i18n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Compare with the locale prefix removed, so /es/projects marks the same link
// active that /projects does.
const pathname = stripLang(Astro.url.pathname.replace(import.meta.env.BASE_URL, ''));
const target = stripLang(String(href ?? '/'));
const section = (p: string) => '/' + (p.match(/[^\/]+/g)?.[0] ?? '');
const isActive = target === pathname || (target !== '/' && target === section(pathname));
---

<!-- Styled by the header it sits in; this only decides which link is current. -->
<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
