---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { alternates, getLangFromUrl } from '../i18n';
import LangRedirect from './LangRedirect.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const alt = alternates(Astro.url);
const altUrl = (path: string) => new URL(path, Astro.site ?? Astro.url);
// Default social-share card lives in /public/og.png. Pages can override it by
// passing their own `image` (e.g. a post hero).
const ogImage = image ? new URL(image.src, Astro.url) : new URL('/og.png', Astro.site ?? Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/masonry/pacman.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Locale alternates, on the pages that have a counterpart. x-default points
     at English, the unprefixed entry point every existing inbound link uses.
     Pages written in one language only (posts, and the indexes that list them)
     declare nothing rather than pointing at a URL that was never built. -->
{
	alt && (
		<>
			<link rel="alternate" hreflang="en" href={altUrl(alt.en)} />
			<link rel="alternate" hreflang="es" href={altUrl(alt.es)} />
			<link rel="alternate" hreflang="x-default" href={altUrl(alt.en)} />
		</>
	)
}
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

{/* Only the English pages sniff the browser; see LangRedirect. */}
{lang === 'en' && <LangRedirect />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
