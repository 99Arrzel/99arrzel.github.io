---
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, localizePath } from '../i18n';
import { useTranslations } from '../i18n/ui';
import HeaderLink from './HeaderLink.astro';
import LangSwitch from './LangSwitch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizePath(path, lang);
---

<header>
	<nav>
		<h2><a href={p('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={p('/')}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={p('/projects')}>{t('nav.projects')}</HeaderLink>
			<HeaderLink href={p('/vault')}>{t('nav.vault')}</HeaderLink>
			<HeaderLink href={p('/interviews')}>{t('nav.interviews')}</HeaderLink>
			<HeaderLink href={p('/about')}>{t('nav.about')}</HeaderLink>
		</div>
		<div class="social-links">
			<LangSwitch />
			<a class="gh" href="https://github.com/99arrzel" target="_blank">
				<span class="sr-only">{t('nav.github')}</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1em;
		/* Fixed, predictable height so content padding (--header-height in
		   global.css) always lines up and the bar can't grow if text wraps. */
		height: var(--header-height);
		display: flex;
		align-items: center;
		background: rgba(15, 15, 20, 0.25);
		backdrop-filter: blur(16px) saturate(180%);
		-webkit-backdrop-filter: blur(16px) saturate(180%);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	h2 {
		margin: 0;
		font-size: 0.85em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--text-heading);
		white-space: nowrap;
	}
	nav {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav .internal-links {
		justify-self: center;
	}
	nav .social-links {
		justify-self: end;
	}
	nav a {
		padding: 0.15em 0.5em;
		color: var(--text);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.85em;
	}
	nav a:hover {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.social-links .gh {
		display: flex;
		color: var(--text-light);
	}
	.social-links .gh:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		/* The GitHub mark is the one thing here that's also in the footer, so
		   it's what gives way when the bar gets tight. The language toggle
		   stays: it's the only way to switch, and it has no duplicate. */
		.social-links .gh {
			display: none;
		}
		/* The brand name doesn't fit alongside all the links on a phone and
		   was wrapping mid-name. Drop it (the "Home" link still navigates home)
		   and give the row to the links plus the toggle. */
		h2 {
			display: none;
		}
		header {
			padding: 0 0.5em;
		}
		nav {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.4em;
		}
		/* Scrolls rather than wraps. The header is a fixed height, so a second
		   line would spill out of the bar — and the Spanish labels are long
		   enough that no font size keeps all five on one line at 320px. */
		nav .internal-links {
			justify-self: stretch;
			display: flex;
			flex-wrap: nowrap;
			gap: 0.1em;
			overflow-x: auto;
			scrollbar-width: none;
			-ms-overflow-style: none;
			-webkit-overflow-scrolling: touch;
			/* Fades the last few pixels so an overflowing row reads as "there's
			   more this way" rather than as a label chopped in half. When the
			   links do fit, the gradient lands on the empty tail of the row and
			   costs nothing. */
			mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent);
			-webkit-mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent);
		}
		nav .internal-links::-webkit-scrollbar {
			display: none;
		}
		nav a {
			font-size: 0.8em;
			padding: 0.15em 0.4em;
			white-space: nowrap;
		}
	}
	/* The Spanish labels are ~20% longer than the English ones and tip the row
	   into scrolling on a standard phone. A little less type gets all five back
	   on screen; below this the row scrolls, which is the honest outcome for
	   any label set long enough. */
	@media (max-width: 430px) {
		nav a {
			font-size: 0.72em;
			padding: 0.15em 0.28em;
		}
	}
</style>
